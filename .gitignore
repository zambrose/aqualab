# Secrets — never commit
.env
.env.*
!.env.example

# Foundry
/cache/
cache/
/out/
out/
/broadcast/

# Foundry libs: ignore everything under lib/ by default, but the swap-vm and
# aqua protocol sources are VENDORED (the GitHub API is blocked in CI so
# `forge install` cannot re-fetch them) and therefore tracked.
/lib/*
!/lib/swap-vm/
!/lib/aqua/

# Node
node_modules/
package-lock.json
dist/

# Temporary subagent worktrees
.claude/worktrees/

# Intermediate trace JSON (generated by TraceExporter test; copied to viz/fixtures by copy-traces.mjs)
/traces/
